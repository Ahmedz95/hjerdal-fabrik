---
// Ramen för alla sidor: metadata, färger, sidhuvud och sidfot. Delas av alla
// kunder. Utseendet ändras i src/styles/ och src/components/brand/, aldrig här.
// Ordningen är lagren: standardvärden, starterns grund, stilens delar, stilens egna
// grepp och sist kundens egen design (tom i startern).
import '../styles/tokens.css';
import '../styles/bas.css';
// Delarna och stilen, en fil var i src/styles/typsnitt/, former/, etiketter/, foton/ och
// stilar/. Sökvägarna sätts i astro.config.mjs efter kundfilen, så att bara de valda
// filerna, och därmed bara de valda typsnitten, följer med.
import '@typsnitt';
import '@former';
import '@etiketter';
import '@foton';
import '@stil';
import forladda from '@typsnitt-forladda';
import '../styles/brand.css';
import Seo from '../components/core/Seo.astro';
import Sidhuvud from '../components/brand/Sidhuvud.astro';
import Sidfot from '../components/brand/Sidfot.astro';
import { brand, sajt } from '../config/site';
import { kund } from '../lib/kund';
import { temaVariabler } from '../lib/tema';
import { valdaDelar } from '../lib/designval';

interface Props {
  title: string;
  description: string;
  /** Sidans sökväg, till exempel "/meny/". */
  sokvag: string;
  ld?: object[];
  noindex?: boolean;
  /** Utan sidhuvud och sidfot, för menyskärmen och QR-skylten. */
  naken?: boolean;
  ogBild?: string;
}

const { title, description, sokvag, ld = [], noindex = false, naken = false, ogBild } = Astro.props;
// Med egna färger sätter kundens tokens.css färgerna, och temat används inte.
const tema = brand.farger === 'tema' ? temaVariabler(kund.design) : undefined;
const delar = valdaDelar(kund.design);
// Startsidans överdel (data-hero). Helbilden finns bara på startsidan; de andra sidorna har
// en rubrik utan bild och får överdelen som text, annars blir rubriken vit på en tom yta.
const hero = !kund.bilder.hero || (kund.design.hero === 'bild' && sokvag !== '/') ? 'text' : kund.design.hero;
---
<!doctype html>
<html lang={sajt.lang} data-stil={kund.design.stil} data-typsnitt={delar.typsnitt} data-former={delar.former} data-etiketter={delar.etiketter} data-foton={delar.foton} data-tema={kund.design.tema} data-hero={hero} data-meny={kund.design.meny}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo {title} {description} {sokvag} {ld} {noindex} {ogBild} temaFarg={tema?.bg ?? brand.temaFarg} />
    {forladda.map((fil) => <link rel="preload" href={fil} as="font" type="font/woff2" crossorigin />)}
    {tema && <style is:inline set:html={tema.css}></style>}
    <slot name="head" />
  </head>
  <body>
    {naken ? (
      <slot />
    ) : (
      <>
        <a class="skip" href="#innehall">Till innehållet</a>
        <Sidhuvud {sokvag} />
        <main id="innehall">
          <slot />
        </main>
        <Sidfot />
      </>
    )}
  </body>
</html>
