---
import Bas from '../layouts/Bas.astro';
import Oppettider from '../components/Oppettider.astro';
import { kund, telLank } from '../lib/kund';
import { restaurangLd } from '../lib/ld';

const { kontakt } = kund;
const { adress } = kontakt;
const description = `Hitta till ${kund.namn} på ${adress.gata} i ${adress.ort}. Öppettider, telefon${kund.boka ? ' och bordsbokning' : ''}.`;
---
<Bas title={`Hitta hit och öppettider | ${kund.namn}`} {description} sokvag="/kontakt/" ld={[restaurangLd()]}>
  <section class="hero">
    <div class="wrap">
      <p class="lbl">Hitta hit</p>
      <h1 class="h1">{adress.gata}, {adress.ort}.</h1>
      <div class="actions">
        {kund.boka && <a class="btn btn-accent" href={kund.boka.url}>{kund.boka.text}</a>}
        {kontakt.karta && <a class="btn btn-line" href={kontakt.karta} rel="noopener">Öppna i kartan</a>}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap split">
      <div>
        <h2 class="lbl">Kontakt</h2>
        <dl class="kontaktlista">
          <div><dt>Adress</dt><dd>{adress.gata}<br />{adress.postnummer} {adress.ort}</dd></div>
          <div><dt>Telefon</dt><dd><a href={telLank(kontakt.telefon)}>{kontakt.telefon}</a></dd></div>
          {kontakt.epost && <div><dt>E-post</dt><dd><a href={`mailto:${kontakt.epost}`}>{kontakt.epost}</a></dd></div>}
        </dl>
      </div>
      <div>
        <h2 class="lbl">Öppettider</h2>
        <Oppettider />
      </div>
    </div>
  </section>
</Bas>
