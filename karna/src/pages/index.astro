---
import { Picture } from 'astro:assets';
import Bas from '../layouts/Bas.astro';
import MenySektion from '../components/MenySektion.astro';
import Oppettider from '../components/Oppettider.astro';
import { kund, url, telLank } from '../lib/kund';
import { dagText, tidText } from '../lib/format';
import { bild } from '../lib/bilder';
import { restaurangLd } from '../lib/ld';

const hero = bild('hero');
const om = bild('om');
// Delad hero och bildhero kräver en bild; utan bild blir det texthero.
const heroLayout = hero ? kund.design.hero : 'text';
const { adress } = kund.kontakt;
// Ett smakprov från första sektionen, högst fyra rätter.
const forsta = kund.meny.sektioner[0];
const smakprov = { ...forsta, ratter: forsta.ratter.slice(0, 4) };
const vardag = kund.oppettider[0];
const title = `${kund.namn} | Restaurang i ${adress.ort}`;
---
<Bas {title} description={kund.beskrivning} sokvag="/" ld={[restaurangLd()]}>
  <section class="hero">
    {heroLayout === 'bild' && hero && (
      <div class="hero-media"><Picture src={hero.src} alt={hero.alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" /></div>
    )}
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="lbl">{kund.kok[0] ?? 'Restaurang'} · {adress.ort}</p>
          <h1 class="h1">{kund.rubrik}</h1>
          <p class="lede">{kund.ingress}</p>
          <div class="actions">
            {kund.boka && <a class="btn btn-accent" href={kund.boka.url}>{kund.boka.text} <span aria-hidden="true">→</span></a>}
            <a class:list={['btn', kund.boka ? 'btn-line' : 'btn-accent']} href={url('/meny/')}>Se menyn</a>
          </div>
        </div>
        {heroLayout === 'delad' && hero && (
          <div class="hero-media"><Picture src={hero.src} alt={hero.alt} widths={[480, 760, 1100]} sizes="(min-width: 900px) 45vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" /></div>
        )}
      </div>
      <dl class="fakta">
        <div><dt>Adress</dt><dd>{adress.gata}, {adress.ort}</dd></div>
        <div><dt>{dagText(vardag.dagar)}</dt><dd class="tab">{tidText(vardag.tider)}</dd></div>
        <div><dt>Telefon</dt><dd><a href={telLank(kund.kontakt.telefon)}>{kund.kontakt.telefon}</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="sec" aria-labelledby="fran-menyn">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="lbl">Från menyn</p>
          <h2 class="h2" id="fran-menyn">{kund.meny.text ? 'Lagat från grunden.' : kund.meny.rubrik}</h2>
        </div>
        {kund.meny.text && <p class="p">{kund.meny.text}</p>}
      </div>
      <MenySektion sektion={smakprov} id="smakprov" rubrikNiva={3} />
      <div class="actions"><a class="tl" href={url('/meny/')}>Hela menyn</a></div>
    </div>
  </section>

  {kund.funktioner.omOss && kund.om && (
    <section class="sec" aria-labelledby="om">
      <div class="wrap split">
        <div>
          <p class="lbl">Om oss</p>
          <h2 class="h2" id="om">{kund.om.rubrik}</h2>
        </div>
        <div>
          {om && <div class="om-bild"><Picture src={om.src} alt={om.alt} widths={[480, 760, 1100]} sizes="(min-width: 900px) 45vw, 100vw" formats={['avif', 'webp']} /></div>}
          <p class="p">{kund.om.stycken[0]}</p>
          <div class="actions"><a class="tl" href={url('/om-oss/')}>Läs mer om oss</a></div>
        </div>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="oppet">
    <div class="wrap split">
      <div>
        <p class="lbl">Öppettider</p>
        <h2 class="h2" id="oppet">Välkommen in.</h2>
        <p class="lede">{adress.gata}, {adress.postnummer} {adress.ort}</p>
        <div class="actions">
          {kund.kontakt.karta && <a class="tl" href={kund.kontakt.karta} rel="noopener">Visa på kartan</a>}
          <a class="tl" href={url('/kontakt/')}>Hitta hit</a>
        </div>
      </div>
      <div><Oppettider /></div>
    </div>
  </section>

  {kund.boka && (
    <section class="band">
      <div class="wrap">
        <h2 class="h2">Boka bord hos {kund.namn}.</h2>
        <div class="actions">
          <a class="btn btn-accent" href={kund.boka.url}>{kund.boka.text} <span aria-hidden="true">→</span></a>
          <a class="tl" href={telLank(kund.kontakt.telefon)}>Eller ring {kund.kontakt.telefon}</a>
        </div>
      </div>
    </section>
  )}
</Bas>
