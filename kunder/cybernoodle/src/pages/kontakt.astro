---
import Bas from '../layouts/Bas.astro';
import Boka from '../components/brand/Boka.astro';
import { kund } from '../lib/kund';
import { restaurangLd } from '../lib/ld';

const { adress } = kund.kontakt;
const description = `Hitta till ${kund.namn} på ${adress.gata} i ${adress.ort}. Öppettider, telefon och bordsbokning direkt på sidan.`;
---
<Bas title={`Hitta hit och boka bord | ${kund.namn}`} {description} sokvag="/kontakt/" ld={[restaurangLd()]}>
  <Boka niva={1} />
</Bas>
